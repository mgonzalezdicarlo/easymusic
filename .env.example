# Public application settings (exposed to the browser)
NEXT_PUBLIC_APP_NAME="Piano Habit Tracker"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (server only). These credentials match docker-compose.yml.
DATABASE_URL="postgresql://piano:piano@localhost:5432/piano"

# Authentication (server only). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Optional GitHub sign-in. Create a GitHub OAuth app with the callback URL
# http://localhost:3000/api/auth/callback/github and set both values, or leave both empty.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""