generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Bootstrap model that proves the migration pipeline end to end.
// E2-02 extends it with timezone, daily goal and the rest of the data model.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("users")
}