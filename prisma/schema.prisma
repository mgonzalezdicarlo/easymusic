generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ScaleMode {
  MAJOR
  NATURAL_MINOR
  HARMONIC_MINOR
  MELODIC_MINOR
  DORIAN
  PHRYGIAN
  LYDIAN
  MIXOLYDIAN
  LOCRIAN
}

enum HandsMode {
  SEPARATE
  TOGETHER
}

// Stored tracking state shared by tracked scales and tracked exercises.
// "Learning / Improving / Mastered" is derived from BPM data, never stored.
enum TrackingStatus {
  ACTIVE
  ARCHIVED
}

// Where an exercise comes from. HANON rows are the shared catalog (no owner). CZERNY and
// CUSTOM rows are created by, and belong to, one user.
enum ExerciseSource {
  HANON
  CZERNY
  CUSTOM
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  emailVerified    Boolean           @default(false)
  name             String
  image            String?
  timezone         String            @default("UTC")
  dailyGoalMinutes Int               @default(30)
  onboardedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  sessions         Session[]
  accounts         Account[]
  practiceSessions PracticeSession[]
  userScales       UserScale[]
  ownedExercises   Exercise[]
  userExercises    UserExercise[]

  @@map("users")
}

// Better Auth tables (ADR-0004). Names and fields follow Better Auth's core schema.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

// Credentials (providerId "credential") hold the password hash; OAuth rows hold provider tokens.
model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// Rate limit counters, stored in the database so they hold across serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}
model PracticeSession {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime                @db.Date
  durationMinutes Int
  notes           String?
  createdAt       DateTime                @default(now())
  scaleEntries    ScalePracticeEntry[]
  exerciseEntries ExercisePracticeEntry[]

  @@index([userId, date])
  @@map("practice_sessions")
}

// Global, read-only catalog: one row per tonic + mode. Seeded in E2-05.
// CHECK in migration: tonic matches ^[A-G][#b]?$
model Scale {
  id         String      @id @default(cuid())
  tonic      String
  mode       ScaleMode
  userScales UserScale[]

  @@unique([tonic, mode])
  @@map("scales")
}

// A scale a user tracks, in one configuration (octaves x hands mode).
// CHECK in migration: octaves 1-4, targetBpm 20-300.
model UserScale {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  scaleId   String
  scale     Scale                @relation(fields: [scaleId], references: [id], onDelete: Restrict)
  octaves   Int
  handsMode HandsMode
  targetBpm Int
  status    TrackingStatus       @default(ACTIVE)
  createdAt DateTime             @default(now())
  entries   ScalePracticeEntry[]

  @@unique([userId, scaleId, octaves, handsMode])
  @@index([scaleId])
  @@map("user_scales")
}

// One practice of a tracked scale inside a session.
// CHECK in migration: cleanBpm and maxBpm 20-300, maxBpm >= cleanBpm, durationMinutes 0-1440.
// practicedAt is a UTC instant used for ordering only; the calendar day is session.date (ADR-0006).
model ScalePracticeEntry {
  id              String          @id @default(cuid())
  userScaleId     String
  userScale       UserScale       @relation(fields: [userScaleId], references: [id], onDelete: Cascade)
  sessionId       String
  session         PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cleanBpm        Int
  maxBpm          Int
  durationMinutes Int
  notes           String?
  practicedAt     DateTime        @default(now())

  @@index([userScaleId, practicedAt])
  @@index([sessionId])
  @@map("scale_practice_entries")
}

// Exercises (E2-04). HANON rows are the shared, read-only catalog and have no owner. CZERNY and
// CUSTOM rows are created by one user, who owns them and is the only one who can see them.
// CHECK in migration: HANON <=> ownerId IS NULL, Hanon number 1-60, number > 0, targetBpm 20-300.
// Partial unique index in migration: one catalog row per (source, number) where ownerId IS NULL.
// number is the Hanon number, or an optional study number for Czerny and custom exercises.
model Exercise {
  id            String         @id @default(cuid())
  source        ExerciseSource
  number        Int?
  title         String
  description   String?
  targetBpm     Int?
  ownerId       String?
  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  userExercises UserExercise[]

  @@unique([ownerId, source, number])
  @@map("exercises")
}

// An exercise a user tracks, once per user. Hands and transposition are optional details of an
// entry, not part of the tracking identity.
// CHECK in migration: targetBpm 20-300.
// The exercise must be visible to the user (catalog or their own); queries use
// visibleExercisesWhere from src/server/exercises/access.ts.
model UserExercise {
  id         String                  @id @default(cuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise                @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  targetBpm  Int
  status     TrackingStatus          @default(ACTIVE)
  createdAt  DateTime                @default(now())
  entries    ExercisePracticeEntry[]

  @@unique([userId, exerciseId])
  @@index([exerciseId])
  @@map("user_exercises")
}

// One practice of a tracked exercise inside a session. Mirrors ScalePracticeEntry.
// CHECK in migration: cleanBpm and maxBpm 20-300, maxBpm >= cleanBpm, durationMinutes 0-1440.
// practicedAt is a UTC instant used for ordering only; the calendar day is session.date (ADR-0006).
model ExercisePracticeEntry {
  id              String          @id @default(cuid())
  userExerciseId  String
  userExercise    UserExercise    @relation(fields: [userExerciseId], references: [id], onDelete: Cascade)
  sessionId       String
  session         PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  cleanBpm        Int
  maxBpm          Int
  durationMinutes Int
  notes           String?
  practicedAt     DateTime        @default(now())

  @@index([userExerciseId, practicedAt])
  @@index([sessionId])
  @@map("exercise_practice_entries")
}
